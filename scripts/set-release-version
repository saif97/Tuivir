#!/usr/bin/env bash

# Sets the tuivir package version in Cargo.toml and Cargo.lock.

set -euo pipefail

stable='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
[[ $# -eq 1 && "$1" =~ $stable ]] || {
  echo 'usage: set-release-version VERSION, with a stable X.Y.Z version' >&2
  exit 2
}

version="$1"
awk -v version="$version" '!done && /^version = / { $0 = "version = \"" version "\""; done = 1 } 1' Cargo.toml > Cargo.toml.new
awk -v version="$version" 'package && /^version = / { $0 = "version = \"" version "\""; package = 0 } $0 == "name = \"tuivir\"" { package = 1 } 1' Cargo.lock > Cargo.lock.new
mv Cargo.toml.new Cargo.toml
mv Cargo.lock.new Cargo.lock
bash "$(dirname "$0")/release-version" "v$version" >/dev/null

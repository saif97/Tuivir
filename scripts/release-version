#!/usr/bin/env bash

set -euo pipefail

tag="${1:-}"
[[ $# -eq 1 && "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
  echo 'release tag must be a stable vX.Y.Z version' >&2
  exit 1
}

version="${tag#v}"
cargo_version="$(cargo metadata --locked --no-deps --format-version 1 | jq -r '.packages[] | select(.name == "tuivir") | .version')"
[[ "$cargo_version" = "$version" ]] || {
  echo "release tag $tag does not match Cargo version $cargo_version" >&2
  exit 1
}

printf '%s\n' "$version"

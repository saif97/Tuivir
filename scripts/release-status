#!/usr/bin/env bash

# Prints "new" when the X.Y.Z version is newer than the latest release and
# "released" when it is the latest release. Fails when it is older.

set -euo pipefail

stable='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
[[ $# -eq 2 && "$1" =~ $stable && "$2" =~ $stable ]] || {
  echo 'usage: release-status VERSION LATEST, with stable X.Y.Z versions' >&2
  exit 2
}

version="$1"
latest="$2"
if [[ "$version" = "$latest" ]]; then
  echo released
elif [[ "$(printf '%s\n' "$latest" "$version" | sort -V | tail -n 1)" = "$version" ]]; then
  echo new
else
  echo "v$version is older than the latest release v$latest" >&2
  exit 1
fi
